<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_nita" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.nita</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group col="2" name="nita_credentials" invisible="code != 'nita'">
                    <field name="nita_base_url" required="code == 'nita'"/>
                    <field name="nita_login" required="code == 'nita'"/>
                    <field name="nita_api_key" password="True" required="code == 'nita'"/>
                    <field name="nita_password" password="True" required="code == 'nita'"/>
                    <field name="nita_hmac_secret" password="True" required="code == 'nita'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
